GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
ILLUSIONTION_MODEL=gemini-3.7-flash
ILLUSIONTION_DECISION_STORE=firestore
ILLUSIONTION_DECISION_COLLECTION=illusiontion_decisions
ILLUSIONTION_PROOF_KMS_KEY_VERSION=projects/PROJECT/locations/global/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/1
ILLUSIONTION_PROOF_PUBLIC_KEY_SHA256=replace-with-official-public-key-sha256
ILLUSIONTION_CLOUD_REGION=me-west1
# ILLUSIONTION_RECEIPT_KEY and ILLUSIONTION_EVIDENCE_KEY should come from Secret Manager.

ILLUSIONTION_EVIDENCE_ALLOWED_ORIGINS=https://csrc.nist.gov,https://www.rfc-editor.org,https://docs.cloud.google.com
