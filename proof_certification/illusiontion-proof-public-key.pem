from __future__ import annotations

import base64
import hashlib
import importlib.util
import json
import os
import platform
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent
VERIFIER = ROOT / "verify_illusiontion_proof.py"
PROOF = ROOT / "r3-proof.json"
SIGNATURE = ROOT / "r3-proof.sig"
PUBLIC_KEY = ROOT / "illusiontion-proof-public-key.pem"
OUTPUT_DIR = ROOT / "certification-output"
REPORT = ROOT / "certification-report.json"


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def canonical_json(value: Any) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")


def load_verifier_module():
    spec = importlib.util.spec_from_file_location(
        "illusiontion_external_verifier_v2",
        VERIFIER,
    )
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load verifier module")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def run_verifier(proof: Path, signature: Path, public_key: Path) -> dict[str, Any]:
    proc = subprocess.run(
        [
            sys.executable,
            "-S",
            str(VERIFIER),
            str(proof),
            str(signature),
            str(public_key),
        ],
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        encoding="utf-8",
        errors="replace",
        check=False,
    )

    checks: dict[str, bool] = {}
    final = None
    for raw in proc.stdout.splitlines():
        line = raw.strip()
        if line.endswith(": PASS"):
            checks[line[:-6]] = True
        elif line.endswith(": FAIL"):
            checks[line[:-6]] = False
        elif line == "ILLUSIONTION_EXTERNAL_PROOF_VERIFIED":
            final = "VERIFIED"
        elif line == "ILLUSIONTION_EXTERNAL_PROOF_INVALID":
            final = "INVALID"

    return {
        "return_code": proc.returncode,
        "final": final,
        "checks": checks,
        "stdout": proc.stdout,
    }



def alternate_verdict(current: str) -> str:
    # Prefer a forged PASS when the real result was not PASS; this exercises
    # the most consequential result-upgrade attack.
    if current != "PASS":
        return "PASS"
    return "HOLD"


def repair_decision_hash(proof: dict[str, Any]) -> None:
    decision = proof["decision"]
    payload = dict(decision)
    payload.pop("decision_sha256", None)
    decision["decision_sha256"] = sha256_bytes(canonical_json(payload))


def der_length(n: int) -> bytes:
    if n < 0x80:
        return bytes([n])
    raw = n.to_bytes((n.bit_length() + 7) // 8, "big")
    return bytes([0x80 | len(raw)]) + raw


def der_tlv(tag: int, value: bytes) -> bytes:
    return bytes([tag]) + der_length(len(value)) + value


def der_integer(n: int) -> bytes:
    raw = n.to_bytes(max(1, (n.bit_length() + 7) // 8), "big")
    if raw[0] & 0x80:
        raw = b"\x00" + raw
    return der_tlv(0x02, raw)


def attacker_private_scalar(curve_n: int) -> int:
    seed = hashlib.sha256(
        b"Illusiontion certification deterministic attacker key v1"
    ).digest()
    return 1 + (int.from_bytes(seed, "big") % (curve_n - 1))


def build_attacker_public_pem(verifier_module, d: int) -> bytes:
    x, y = verifier_module.point_mul(d, verifier_module.G)
    point = b"\x04" + x.to_bytes(32, "big") + y.to_bytes(32, "big")

    oid_ec_public_key = bytes.fromhex("06072a8648ce3d0201")
    oid_prime256v1 = bytes.fromhex("06082a8648ce3d030107")
    algorithm = der_tlv(0x30, oid_ec_public_key + oid_prime256v1)
    bit_string = der_tlv(0x03, b"\x00" + point)
    spki = der_tlv(0x30, algorithm + bit_string)

    body = base64.b64encode(spki).decode("ascii")
    wrapped = "\n".join(body[i:i + 64] for i in range(0, len(body), 64))
    return (
        "-----BEGIN PUBLIC KEY-----\n"
        + wrapped
        + "\n-----END PUBLIC KEY-----\n"
    ).encode("ascii")


def sign_attacker(verifier_module, message: bytes, d: int) -> bytes:
    digest = hashlib.sha256(message).digest()
    z = int.from_bytes(digest, "big")
    n = verifier_module.N

    counter = 0
    while True:
        nonce_seed = hashlib.sha256(
            b"Illusiontion certification deterministic ECDSA nonce v1"
            + digest
            + counter.to_bytes(4, "big")
        ).digest()
        k = 1 + (int.from_bytes(nonce_seed, "big") % (n - 1))
        x, _ = verifier_module.point_mul(k, verifier_module.G)
        r = x % n
        if r == 0:
            counter += 1
            continue
        s = (pow(k, -1, n) * (z + r * d)) % n
        if s == 0:
            counter += 1
            continue
        # Canonical low-S form is not required by the verifier, but keeps the
        # generated attack signature stable and conventional.
        if s > n // 2:
            s = n - s
        return der_tlv(0x30, der_integer(r) + der_integer(s))


def expectation(result: dict[str, Any], *, final: str, required: dict[str, bool]) -> tuple[bool, list[str]]:
    failures = []
    if result["final"] != final:
        failures.append(f"final expected {final}, got {result['final']}")
    for name, expected in required.items():
        actual = result["checks"].get(name)
        if actual is not expected:
            failures.append(f"{name} expected {expected}, got {actual}")
    return not failures, failures


def test_record(name: str, description: str, result: dict[str, Any], passed: bool, failures: list[str]) -> dict[str, Any]:
    return {
        "name": name,
        "description": description,
        "passed": passed,
        "failures": failures,
        "verifier_return_code": result["return_code"],
        "verifier_final": result["final"],
        "checks": result["checks"],
        "stdout": result["stdout"],
    }


def main() -> int:
    if OUTPUT_DIR.exists():
        shutil.rmtree(OUTPUT_DIR)
    OUTPUT_DIR.mkdir(parents=True)

    tests: list[dict[str, Any]] = []

    genuine = run_verifier(PROOF, SIGNATURE, PUBLIC_KEY)
    genuine_required = {
        "official_key_pin": True,
        "kms_key_version_pin": True,
        "canonical_json": True,
        "proof_schema": True,
        "proof_type": True,
        "public_key_sha256": True,
        "decision_object": True,
        "decision_sha256": True,
        "claim_id_binding": True,
        "verdict_domain": True,
        "kms_signature": True,
    }
    passed, failures = expectation(
        genuine,
        final="VERIFIED",
        required=genuine_required,
    )
    tests.append(
        test_record(
            "genuine_proof_control",
            "Untouched final fortified PASS proof must verify under the pinned Illusiontion trust anchor.",
            genuine,
            passed,
            failures,
        )
    )

    original_proof = json.loads(PROOF.read_text(encoding="utf-8"))
    original_verdict = original_proof["decision"]["verdict"]
    forged_verdict = alternate_verdict(original_verdict)

    # H1: attacker changes the verdict and repairs the internal decision hash.
    repaired = json.loads(json.dumps(original_proof))
    repaired["decision"]["verdict"] = forged_verdict
    repair_decision_hash(repaired)
    repaired_bytes = canonical_json(repaired)
    repaired_path = OUTPUT_DIR / "attack-repaired-hash-proof.json"
    repaired_path.write_bytes(repaired_bytes)
    repaired_result = run_verifier(repaired_path, SIGNATURE, PUBLIC_KEY)
    passed, failures = expectation(
        repaired_result,
        final="INVALID",
        required={
            "official_key_pin": True,
            "kms_key_version_pin": True,
            "canonical_json": True,
            "decision_sha256": True,
            "verdict_domain": True,
            "kms_signature": False,
        },
    )
    tests.append(
        test_record(
            "repaired_hash_forgery",
            f"Change governed verdict {original_verdict!r} -> {forged_verdict!r}, recompute decision_sha256, retain the genuine KMS signature; verifier must still reject.",
            repaired_result,
            passed,
            failures,
        )
    )

    # H2: one-bit signature corruption with untouched proof.
    corrupted_sig = bytearray(SIGNATURE.read_bytes())
    if not corrupted_sig:
        raise RuntimeError("signature is empty")
    corrupted_sig[-1] ^= 0x01
    corrupted_sig_path = OUTPUT_DIR / "attack-corrupted-signature.sig"
    corrupted_sig_path.write_bytes(bytes(corrupted_sig))
    corrupted_result = run_verifier(PROOF, corrupted_sig_path, PUBLIC_KEY)
    passed, failures = expectation(
        corrupted_result,
        final="INVALID",
        required={
            "official_key_pin": True,
            "kms_key_version_pin": True,
            "canonical_json": True,
            "decision_sha256": True,
            "claim_id_binding": True,
            "verdict_domain": True,
            "kms_signature": False,
        },
    )
    tests.append(
        test_record(
            "corrupted_signature",
            "Flip one bit in the signature while leaving the proof untouched; verifier must reject solely at cryptographic authentication.",
            corrupted_result,
            passed,
            failures,
        )
    )

    # H3 regression: attacker supplies its own key, updates the embedded key
    # fingerprint, repairs the decision hash, and creates a valid attacker
    # signature. The mathematical signature is valid, but the official key pin
    # must reject it.
    verifier_module = load_verifier_module()
    attacker_d = attacker_private_scalar(verifier_module.N)
    attacker_public_pem = build_attacker_public_pem(verifier_module, attacker_d)
    attacker_public_path = OUTPUT_DIR / "attack-substitute-public-key.pem"
    attacker_public_path.write_bytes(attacker_public_pem)

    substituted = json.loads(json.dumps(original_proof))
    substituted["decision"]["verdict"] = forged_verdict
    repair_decision_hash(substituted)
    substituted["issuer"]["public_key_sha256"] = sha256_bytes(attacker_public_pem)
    substituted_bytes = canonical_json(substituted)
    substituted_path = OUTPUT_DIR / "attack-key-substitution-proof.json"
    substituted_path.write_bytes(substituted_bytes)
    attacker_signature = sign_attacker(verifier_module, substituted_bytes, attacker_d)
    attacker_sig_path = OUTPUT_DIR / "attack-key-substitution.sig"
    attacker_sig_path.write_bytes(attacker_signature)

    substitution_result = run_verifier(
        substituted_path,
        attacker_sig_path,
        attacker_public_path,
    )
    passed, failures = expectation(
        substitution_result,
        final="INVALID",
        required={
            "official_key_pin": False,
            "kms_key_version_pin": True,
            "canonical_json": True,
            "proof_schema": True,
            "proof_type": True,
            "public_key_sha256": True,
            "decision_object": True,
            "decision_sha256": True,
            "claim_id_binding": True,
            "verdict_domain": True,
            "kms_signature": True,
        },
    )
    tests.append(
        test_record(
            "key_substitution_regression",
            "Forge the decision, repair its hash, substitute a self-generated P-256 key, update the embedded key fingerprint, and sign correctly with the attacker key. The signature must be mathematically valid but the pinned official-key check must reject it.",
            substitution_result,
            passed,
            failures,
        )
    )

    overall = all(t["passed"] for t in tests)

    report = {
        "certification_schema": "illusiontion.external-proof-certification.v1",
        "generated_at_utc": datetime.now(timezone.utc).isoformat(),
        "overall_status": "PASS" if overall else "FAIL",
        "certification_scope": (
            "Offline verification behavior of the final fortified PASS governed-decision proof and verifier-v2 trust-anchor regressions."
        ),
        "important_boundary": (
            "This certifies cryptographic/structural verification behavior for the supplied artifact and verifier. It is not independent third-party validation of Illusiontion's substantive reviewer correctness or of Google Cloud operations beyond what the signed artifact commits to."
        ),
        "execution": {
            "python": sys.version.split()[0],
            "python_executable": sys.executable,
            "python_site_disabled_for_verifier": True,
            "platform": platform.platform(),
        },
        "inputs": {
            "proof": {
                "file": PROOF.name,
                "sha256": sha256_file(PROOF),
                "claim_id": original_proof.get("claim_id"),
                "verdict": original_verdict,
            },
            "signature": {
                "file": SIGNATURE.name,
                "sha256": sha256_file(SIGNATURE),
            },
            "public_key": {
                "file": PUBLIC_KEY.name,
                "sha256": sha256_file(PUBLIC_KEY),
            },
            "verifier": {
                "file": VERIFIER.name,
                "sha256": sha256_file(VERIFIER),
                "pinned_public_key_sha256": getattr(
                    load_verifier_module(),
                    "EXPECTED_PUBLIC_KEY_SHA256",
                    None,
                ),
                "pinned_kms_key_version": getattr(
                    load_verifier_module(),
                    "EXPECTED_KMS_KEY_VERSION",
                    None,
                ),
            },
        },
        "tests": tests,
        "summary": {
            "test_count": len(tests),
            "passed": sum(1 for t in tests if t["passed"]),
            "failed": sum(1 for t in tests if not t["passed"]),
        },
    }

    REPORT.write_text(
        json.dumps(report, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )

    print("ILLUSIONTION PROOF VERIFICATION CERTIFICATION")
    print("=" * 47)
    for test in tests:
        print(f"{test['name']}: {'PASS' if test['passed'] else 'FAIL'}")
        if not test["passed"]:
            for failure in test["failures"]:
                print(f"  - {failure}")
    print("-" * 47)
    print(f"OVERALL: {'PASS' if overall else 'FAIL'}")
    print(f"REPORT: {REPORT.name}")
    if overall:
        print("ILLUSIONTION_EXTERNAL_PROOF_CERTIFICATION_PASS")
        return 0
    print("ILLUSIONTION_EXTERNAL_PROOF_CERTIFICATION_FAIL")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
